{
  "name": "repo-tray",
  "version": "0.1.2",
  "description": "Quiet Git monitoring for your menu bar and system tray",
  "author": "Repo Tray",
  "homepage": "https://github.com/GGULBAE/repo-tray#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GGULBAE/repo-tray.git"
  },
  "bugs": {
    "url": "https://github.com/GGULBAE/repo-tray/issues"
  },
  "private": true,
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node scripts/smoke.cjs",
    "test:packaged": "node scripts/test-packaged.cjs",
    "icons": "node scripts/icons.cjs",
    "check": "node scripts/check.cjs",
    "verify": "npm run check && npm test",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac zip --arm64 --x64",
    "dist:win": "electron-builder --win nsis --x64",
    "dist": "electron-builder --mac zip --arm64 --x64 --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "dev.repotray.desktop",
    "productName": "Repo Tray",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "artifactName": "Repo-Tray-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/app.icns",
      "identity": null,
      "extendInfo": {
        "NSHighResolutionCapable": true
      }
    },
    "win": {
      "icon": "assets/app.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
